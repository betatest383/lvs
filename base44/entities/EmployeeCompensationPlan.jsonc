{
  "name": "EmployeeCompensationPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID",
      "description": "Links to EmployeeRegistry. When set, this plan is specific to one employee."
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "e.g. Lead Technician, Apprentice, Mason. Used for role-based plan matching when employee_id is not set."
    },
    "compensation_method": {
      "type": "string",
      "enum": [
        "hourly",
        "commission",
        "salary",
        "hourly_plus_commission"
      ],
      "default": "hourly",
      "title": "Compensation Method"
    },
    "hourly_rate": {
      "type": "number",
      "default": 0,
      "title": "Hourly Rate ($)"
    },
    "salary_amount": {
      "type": "number",
      "default": 0,
      "title": "Annual Salary ($)"
    },
    "commission_rate_percentage": {
      "type": "number",
      "default": 0,
      "title": "Commission Rate (%)"
    },
    "commission_basis": {
      "type": "string",
      "enum": [
        "job_subtotal",
        "completed_revenue",
        "collected_revenue",
        "service_revenue",
        "gross_profit",
        "custom"
      ],
      "default": "job_subtotal",
      "title": "Commission Basis"
    },
    "commission_timing": {
      "type": "string",
      "enum": [
        "estimate_approved",
        "work_completed",
        "invoice_closed",
        "payment_collected"
      ],
      "default": "work_completed",
      "title": "Commission Timing",
      "description": "When the commission is considered earned"
    },
    "include_chargeable_materials": {
      "type": "boolean",
      "default": true,
      "title": "Include Chargeable Materials"
    },
    "include_service_revenue": {
      "type": "boolean",
      "default": true,
      "title": "Include Service Revenue"
    },
    "include_visible_price_modifiers": {
      "type": "boolean",
      "default": true,
      "title": "Include Visible Price Modifiers"
    },
    "include_discounts": {
      "type": "boolean",
      "default": true,
      "title": "Subtract Discounts",
      "description": "When true, discounts reduce the commissionable subtotal"
    },
    "include_tax": {
      "type": "boolean",
      "default": false,
      "title": "Include Sales Tax"
    },
    "include_financing_fees": {
      "type": "boolean",
      "default": false,
      "title": "Include Financing Fees"
    },
    "include_permits": {
      "type": "boolean",
      "default": false,
      "title": "Include Permit Fees"
    },
    "include_subcontractors": {
      "type": "boolean",
      "default": false,
      "title": "Include Subcontractor Pass-through"
    },
    "include_membership_revenue": {
      "type": "boolean",
      "default": false,
      "title": "Include Membership Revenue"
    },
    "minimum_margin_required": {
      "type": "number",
      "title": "Minimum Margin Required (%)",
      "description": "If set, commission is not earned when gross margin falls below this threshold"
    },
    "effective_start_date": {
      "type": "string",
      "format": "date",
      "title": "Effective Start Date"
    },
    "effective_end_date": {
      "type": "string",
      "format": "date",
      "title": "Effective End Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active",
      "title": "Status"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "updated_by": {
      "type": "string",
      "title": "Updated By"
    }
  },
  "required": [
    "name",
    "compensation_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
