      "title": "Current Blocker"
    },
    "waiting_reason": {
      "type": "string",
      "title": "Waiting Reason"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "simple_action",
        "checklist",
        "guided_task",
        "form",
        "workflow",
        "wizard",
        "automated",
        "linked_module"
      ],
      "title": "Execution Mode",
