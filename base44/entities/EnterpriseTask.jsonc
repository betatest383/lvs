      "items": {
        "type": "string"
      },
      "title": "Related Task IDs"
    },
    "interrupted_task_id": {
      "type": "string",
      "title": "Interrupted Task ID"
    },
    "interrupting_task_id": {
      "type": "string",
      "title": "Interrupting Task ID"
    },
    "resume_task_id": {
      "type": "string",
      "title": "Resume Task ID"
    },
    "orchestration_status": {
      "type": "string",
      "enum": [
        "draft",
        "queued",
        "offered",
        "assigned",
        "acknowledgment_required",
        "acknowledged",
        "in_progress",
        "paused",
        "paused_by_higher_priority",
        "waiting_on_person",
        "waiting_on_material",
        "waiting_on_approval",
        "blocked",
        "overdue",
        "focus_required",
        "completed",
        "cancelled",
        "superseded",
        "archived"
      ],
      "title": "Orchestration Status",
      "description": "Orchestration state machine status (separate from the legacy status field)"
    },
    "acknowledgment_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "acknowledged",
        "start_now",
        "request_clarification",
        "unable_to_start",
        "manager_assistance_requested",
        "overdue",
        "escalated"
      ],
      "default": "none",
      "title": "Acknowledgment Status"
    },
    "response_category": {
      "type": "string",
      "title": "Response Category",
      "description": "Snapshot of the latest employee response category (reason/help category)"
    },
    "manager_followup_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "responded",
        "closed"
      ],
      "default": "none",
      "title": "Manager Follow-Up Status",
      "description": "Tracks the state of the manager follow-up created when an employee requests clarification, is unable to start, or requests manager help."
    },
    "manager_followup_notification_id": {
      "type": "string",
      "title": "Manager Follow-Up Notification ID",
