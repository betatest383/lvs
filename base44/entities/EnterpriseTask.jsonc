    },
    "manager_response": {
      "type": "string",
      "title": "Manager Response",
      "description": "Manager's clarification or response message sent back to the employee"
    },
    "focus_lock_status": {
      "type": "string",
      "enum": [
        "none",
        "eligible",
        "active",
        "override_requested"
      ],
      "default": "none",
      "title": "Focus Lock Status"
    },
