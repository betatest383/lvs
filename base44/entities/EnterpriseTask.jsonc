      "type": "boolean",
      "default": false,
      "title": "Requires Immediate Acknowledgment"
    },
    "acknowledgment_deadline_minutes": {
      "type": "number",
      "title": "Acknowledgment Deadline (Minutes)"
    },
    "may_be_paused": {
      "type": "boolean",
      "default": true,
      "title": "May Be Paused"
    },
    "resume_required": {
      "type": "boolean",
      "default": false,
      "title": "Resume Required"
    },
    "focus_lock_eligible": {
      "type": "boolean",
      "default": false,
      "title": "Focus Lock Eligible"
    },
    "source_event_type": {
      "type": "string",
      "title": "Source Event Type"
    },
    "source_event_id": {
      "type": "string",
      "title": "Source Event ID"
    },
    "workflow_type": {
      "type": "string",
      "title": "Workflow Type"
    },
    "workflow_session_id": {
      "type": "string",
      "title": "Workflow Session ID"
    },
    "related_task_ids": {
