    "task_template_id": {
      "type": "string",
      "title": "Task Template ID",
      "description": "Canonical TaskTemplate ID if this task was created from a template"
    },
    "task_template_number": {
      "type": "string",
      "title": "Task Template Number",
      "description": "Snapshot of template_number at creation time"
    },
    "task_template_version": {
      "type": "number",
      "title": "Task Template Version",
      "description": "Snapshot of template version at creation time"
    },
    "template_defaults_snapshot": {
      "type": "string",
      "title": "Template Defaults Snapshot (JSON)",
      "description": "JSON snapshot of all template-derived field values at creation time. Used for audit and to detect overrides."
    },
    "template_override_history": {
      "type": "string",
      "title": "Template Override History (JSON)",
      "description": "JSON array of {field, template_value, previous_task_value, new_value, reason, changed_by_employee_id, changed_by_name, changed_at}"
    },
    "template_override_reason": {
      "type": "string",
      "title": "Template Override Reason",
      "description": "Reason provided when overriding controlled template-derived fields"
    },
    "test_purpose": {
      "type": "string",
      "title": "Test Purpose",
      "description": "Required when creating a test record. Records why the test task was created and who authorized it."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.assigned_to_linked_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.assigned_to_linked_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
