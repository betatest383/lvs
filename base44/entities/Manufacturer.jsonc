{
  "name": "Manufacturer",
  "type": "object",
  "properties": {
    "manufacturer_code": {
      "type": "string",
      "title": "Manufacturer Code",
      "description": "e.g. MFR-001"
    },
    "name": {
      "type": "string",
      "title": "Manufacturer Name"
    },
    "legal_name": {
      "type": "string",
      "title": "Legal Name"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ]
}