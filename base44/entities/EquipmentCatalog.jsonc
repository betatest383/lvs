{
  "name": "EquipmentCatalog",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "title": "Item Name"
    },
    "category": {
      "type": "string",
      "enum": [
        "camera",
        "brush",
        "ladder",
        "vacuum",
        "hand_tool",
        "safety",
        "measurement",
        "vehicle",
        "other"
      ],
      "title": "Category"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity in Stock"
    },
    "default_value": {
      "type": "number",
      "title": "Default Value ($)"
    },
    "sku": {
      "type": "string",
      "title": "SKU / Part Number"
    },
    "supplier": {
      "type": "string",
      "title": "Supplier"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "item_name"
  ]
}