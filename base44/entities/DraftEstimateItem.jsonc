{
  "name": "DraftEstimateItem",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string",
      "title": "Estimate ID"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "appointment_id": {
      "type": "string",
      "title": "Appointment ID"
    },
    "inspection_id": {
      "type": "string",
      "title": "Inspection ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "recommendation_review_id": {
      "type": "string",
      "title": "Recommendation Review ID"
    },
    "recommendation_review_item_id": {
      "type": "string",
      "title": "Recommendation Review Item ID"
    },
    "repair_system_recommendation_id": {
      "type": "string",
      "title": "Repair System Recommendation ID"
    },
    "repair_recommendation_template_id": {
      "type": "string",
      "title": "Repair Recommendation Template ID",
      "description": "The RepairRecommendationTemplate that was matched to produce this item"
    },
    "finding_id": {
      "type": "string",
      "title": "Finding ID"
    },
    "finding_type": {
      "type": "string",
      "title": "Finding Type",
      "description": "InspectionFinding or Finding"
    },
    "deficiency_type": {
      "type": "string",
      "title": "Deficiency Type"
    },
    "severity": {
      "type": "string",
      "title": "Severity"
    },
    "source_title": {
      "type": "string",
      "title": "Source Title",
      "description": "Finding location or deficiency description"
    },
    "source_description": {
      "type": "string",
      "title": "Source Description"
    },
    "service_catalog_id": {
      "type": "string",
      "title": "Service Catalog ID"
    },
    "service_name": {
      "type": "string",
      "title": "Service Name"
    },
    "service_code": {
      "type": "string",
      "title": "Service Code"
    },
    "service_description": {
      "type": "string",
      "title": "Service Description"
    },
    "customer_facing_summary": {
      "type": "string",
      "title": "Customer-Facing Summary"
    },
    "customer_description": {
      "type": "string",
      "title": "Customer Description",
      "description": "Customer-facing description used during Presentation (generated by Service Configuration Engine)"
    },
    "estimated_time_hours": {
      "type": "number",
      "default": 0,
      "title": "Estimated Time (Hours)"
    },
    "estimated_time_minutes": {
      "type": "number",
      "default": 0,
      "title": "Estimated Time (Minutes)"
    },
    "service_price": {
      "type": "number",
      "default": 0,
      "title": "Service Price"
    },
    "internal_cost": {
      "type": "number",
      "default": 0,
      "title": "Internal Cost",
      "description": "Generated by Service Configuration Engine"
    },
    "gross_profit": {
      "type": "number",
      "default": 0,
      "title": "Gross Profit",
      "description": "service_price - internal_cost"
    },
    "gross_margin": {
      "type": "number",
      "default": 0,
      "title": "Gross Margin (%)"
    },
    "membership_price": {
      "type": "number",
      "default": 0,
      "title": "Membership Price"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "Quantity"
    },
    "service_commission_type": {
      "type": "string",
      "enum": [
        "percentage",
        "flat_dollar",
        "none"
      ],
      "default": "none",
      "title": "Service Commission Type"
    },
    "service_commission_value": {
      "type": "number",
      "default": 0,
      "title": "Service Commission Value"
    },
    "service_commission_amount": {
      "type": "number",
      "default": 0,
      "title": "Service Commission Amount"
    },
    "materials": {
      "type": "string",
      "title": "Materials (JSON)",
      "description": "JSON array of {material_id, material_name, quantity, unit, unit_price, chargeable_to_customer, customer_visible, commission_type, commission_value}"
    },
    "chargeable_materials_total": {
      "type": "number",
      "default": 0,
      "title": "Chargeable Materials Total"
    },
    "internal_materials_total": {
      "type": "number",
      "default": 0,
      "title": "Internal Materials Total"
    },
    "material_commission_amount": {
      "type": "number",
      "default": 0,
      "title": "Material Commission Amount"
    },
    "total_item_price": {
      "type": "number",
      "default": 0,
      "title": "Total Item Price"
    },
    "crew_size_required": {
      "type": "number",
      "default": 1,
      "title": "Crew Size Required",
      "description": "Generated by Service Configuration Engine"
    },
    "labor_phases": {
      "type": "string",
      "title": "Labor Phases (JSON)",
      "description": "Generated by Service Configuration Engine: [{phase_name, estimated_hours, tasks[]}]"
    },
    "required_equipment": {
      "type": "string",
      "title": "Required Equipment (JSON)",
      "description": "Generated by Service Configuration Engine: [{equipment_master_id, item_name, quantity, notes}]"
    },
    "scope_of_work": {
      "type": "string",
      "title": "Scope of Work (JSON)",
      "description": "Generated by Service Configuration Engine: {work_phases[], safety_notes[], cleanup_tasks[], internal_notes}"
    },
    "proposal_tier": {
      "type": "string",
      "enum": [
        "good",
        "better",
        "best",
        "standalone"
      ],
      "default": "standalone",
      "title": "Proposal Tier"
    },
    "proposal_customer_benefits": {
      "type": "string",
      "title": "Proposal Customer Benefits"
    },
    "proposal_warranty_messaging": {
      "type": "string",
      "title": "Proposal Warranty Messaging"
    },
    "proposal_estimated_duration": {
      "type": "string",
      "title": "Proposal Estimated Duration"
    },
    "is_service_only": {
      "type": "boolean",
      "default": false,
      "title": "Service Only"
    },
    "committed_work_key": {
      "type": "string",
      "title": "Committed Work Key",
      "description": "Stable deduplication key for idempotent estimate rebuilds. Cap items use: cap-base:{rec_id}:{matrix_id}, cap-finish:{rec_id}:{pricing_id}, cap-color-premium:{rec_id}:{color_id}, cap-cutdown:{rec_id}:{flue_id}. Upsert by this key prevents duplicate charges across rebuilds."
    },
    "cap_snapshot_ref": {
      "type": "string",
      "title": "Cap Snapshot Reference",
      "description": "RepairSystemRecommendation ID that owns the cap sizing snapshot this item was generated from."
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "suggested_service",
        "manual_review",
        "missing_price",
        "approved",
        "deferred",
        "rejected"
      ],
      "default": "manual_review",
      "title": "Item Status"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "estimate_id",
    "job_id"
  ]
}