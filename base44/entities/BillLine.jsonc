{
  "name": "BillLine",
  "type": "object",
  "properties": {
    "bill_id": {
      "type": "string",
      "title": "Bill ID",
      "description": "Links to local Bill header record."
    },
    "servicetitan_bill_id": {
      "type": "string",
      "title": "ServiceTitan Bill ID",
      "description": "Snapshot of the parent bill's ST ID for display without joining."
    },
    "purchase_order_id": {
      "type": "string",
      "title": "Purchase Order ID",
      "description": "Links to local PurchaseOrder. Resolved via servicetitan_purchase_order_id."
    },
    "purchase_order_line_id": {
      "type": "string",
      "title": "Purchase Order Line ID",
      "description": "Links to local PurchaseOrderLine. Resolved via servicetitan_po_line_id."
    },
    "servicetitan_po_line_id": {
      "type": "string",
      "title": "ServiceTitan PO Line ID"
    },
    "receipt_id": {
      "type": "string",
      "title": "Receipt ID",
      "description": "Links to local Receipt. Resolved via servicetitan_receipt_id."
    },
    "receipt_line_id": {
      "type": "string",
      "title": "Receipt Line ID",
      "description": "Links to local ReceiptLine. Resolved via servicetitan_receipt_line_id."
    },
    "servicetitan_receipt_line_id": {
      "type": "string",
      "title": "ServiceTitan Receipt Line ID"
    },
    "inventory_master_id": {
      "type": "string",
      "title": "Inventory Master ID",
      "description": "Links to local InventoryMaster. Resolved via servicetitan_material_id."
    },
    "servicetitan_material_id": {
      "type": "string",
      "title": "ServiceTitan Material ID"
    },
    "sku": {
      "type": "string",
      "title": "SKU",
      "description": "Denormalized for reporting."
    },
    "item_name": {
      "type": "string",
      "title": "Item Name",
      "description": "Denormalized for reporting."
    },
    "unit_of_measure": {
      "type": "string",
      "title": "Unit of Measure",
      "default": "ea"
    },
    "quantity_billed": {
      "type": "number",
      "default": 0,
      "title": "Quantity Billed",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "title": "Unit Cost",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "line_total": {
      "type": "number",
      "default": 0,
      "title": "Line Total",
      "description": "ServiceTitan-owned. quantity_billed \u00d7 unit_cost. Overwritten by inbound sync."
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "title": "Tax Amount",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "tax_code": {
      "type": "string",
      "title": "Tax Code",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "line_status": {
      "type": "string",
      "enum": [
        "open",
        "billed",
        "disputed",
        "cancelled"
      ],
      "default": "open",
      "title": "Line Status",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "gl_account": {
      "type": "string",
      "title": "GL Account",
      "description": "LVC-owned. Internal GL posting account. Never overwritten by ServiceTitan."
    },
    "gl_posted": {
      "type": "boolean",
      "default": false,
      "title": "GL Posted",
      "description": "LVC-owned. Never overwritten by ServiceTitan."
    },
    "dispute_flag": {
      "type": "boolean",
      "default": false,
      "title": "Dispute Flag",
      "description": "LVC-owned. Never overwritten by ServiceTitan."
    },
    "dispute_reason": {
      "type": "string",
      "title": "Dispute Reason",
      "description": "LVC-owned. Never overwritten by ServiceTitan."
    },
    "servicetitan_bill_line_id": {
      "type": "string",
      "title": "ServiceTitan Bill Line ID",
      "description": "Permanent external identity. Stored as string for int64 safety. The canonical sync key \u2014 matched ONLY by this field."
    },
    "servicetitan_active": {
      "type": "boolean",
      "default": true,
      "title": "ServiceTitan Active Status"
    },
    "servicetitan_sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "conflict",
        "deferred",
        "failed",
        "deleted"
      ],
      "default": "synced",
      "title": "ServiceTitan Sync Status"
    },
    "servicetitan_last_sync": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Last Sync"
    },
    "servicetitan_last_event_at": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Last Event At"
    },
    "servicetitan_modified_on": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Modified On"
    },
    "servicetitan_created_on": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Created On"
    },
    "servicetitan_sync_version": {
      "type": "number",
      "default": 0,
      "title": "ServiceTitan Sync Version"
    },
    "servicetitan_source": {
      "type": "string",
      "enum": [
        "webhook",
        "manual",
        "api"
      ],
      "title": "ServiceTitan Source"
    },
    "servicetitan_raw_data": {
      "type": "string",
      "title": "ServiceTitan Raw Data (JSON)"
    },
    "import_source": {
      "type": "string",
      "enum": [
        "webhook",
        "api_recovery",
        "on_demand_hydration",
        "manual",
        "api_export"
      ],
      "title": "Import Source"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported At"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "LVC-owned internal notes. Never overwritten by ServiceTitan."
    }
  },
  "required": [
    "bill_id",
    "servicetitan_bill_line_id",
    "line_status"
  ]
}