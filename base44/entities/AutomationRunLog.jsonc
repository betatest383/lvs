{
  "name": "AutomationRunLog",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string",
      "title": "Log ID",
      "description": "e.g. LOG-000001"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "event",
        "rule_run",
        "simulation"
      ],
      "default": "event",
      "title": "Log Type"
    },
    "source_module": {
      "type": "string",
      "title": "Source Module"
    },
    "source_module_name": {
      "type": "string",
      "title": "Source Module Name"
    },
    "trigger_event": {
      "type": "string",
      "title": "Trigger Event"
    },
    "trigger_event_name": {
      "type": "string",
      "title": "Trigger Event Name"
    },
    "event_payload_json": {
      "type": "string",
      "title": "Event Payload (JSON)"
    },
    "related_record_id": {
      "type": "string",
      "title": "Related Record ID"
    },
    "employee": {
      "type": "string",
      "title": "Employee"
    },
    "truck": {
      "type": "string",
      "title": "Truck"
    },
    "rule_id": {
      "type": "string",
      "title": "Rule ID"
    },
    "rule_name": {
      "type": "string",
      "title": "Rule Name"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "matched",
        "no_match",
        "evaluated",
        "success",
        "failed",
        "error",
        "paused",
        "skipped"
      ],
      "default": "received",
      "title": "Status"
    },
    "conditions_met": {
      "type": "boolean",
      "default": false,
      "title": "Conditions Met"
    },
    "conditions_evaluated_json": {
      "type": "string",
      "title": "Conditions Evaluated (JSON)"
    },
    "actions_executed_json": {
      "type": "string",
      "title": "Actions Executed (JSON)"
    },
    "execution_trace_json": {
      "type": "string",
      "title": "Execution Trace (JSON)",
      "description": "Ordered array of trace steps with timestamps: [{step, module, action, status, timestamp, duration_ms, details}]"
    },
    "breakpoint_hit": {
      "type": "string",
      "title": "Breakpoint Hit",
      "description": "The action key where simulation paused, if any"
    },
    "simulation_id": {
      "type": "string",
      "title": "Simulation ID",
      "description": "Unique ID linking simulation log entries together"
    },
    "error_message": {
      "type": "string",
      "title": "Error Message"
    },
    "duration_ms": {
      "type": "number",
      "title": "Duration (ms)"
    },
    "triggered_by": {
      "type": "string",
      "title": "Triggered By"
    }
  },
  "required": [
    "log_id",
    "log_type"
  ]
}