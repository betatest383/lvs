{
  "name": "PurchaseOrderLine",
  "type": "object",
  "properties": {
    "purchase_order_id": {
      "type": "string",
      "title": "Purchase Order ID",
      "description": "Links to PurchaseOrder header record. Resolved via servicetitan_purchase_order_id."
    },
    "servicetitan_purchase_order_id": {
      "type": "string",
      "title": "ServiceTitan Purchase Order ID",
      "description": "Snapshot of the parent PO's ST ID for display without joining."
    },
    "po_number": {
      "type": "string",
      "title": "PO Number",
      "description": "Denormalized for reporting."
    },
    "inventory_master_id": {
      "type": "string",
      "title": "Inventory Master ID",
      "description": "Links to InventoryMaster record. Resolved via servicetitan_material_id."
    },
    "servicetitan_material_id": {
      "type": "string",
      "title": "ServiceTitan Material ID",
      "description": "Snapshot of the material's ST ID for immutable linkage."
    },
    "sku": {
      "type": "string",
      "title": "SKU",
      "description": "ServiceTitan-owned. Denormalized from ST. Overwritten by inbound sync."
    },
    "item_name": {
      "type": "string",
      "title": "Item Name",
      "description": "ServiceTitan-owned. Denormalized from ST. Overwritten by inbound sync."
    },
    "vendor_sku": {
      "type": "string",
      "title": "Vendor SKU",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "unit_of_measure": {
      "type": "string",
      "title": "Unit of Measure",
      "default": "ea",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "quantity_ordered": {
      "type": "number",
      "default": 1,
      "title": "Quantity Ordered",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "quantity_received": {
      "type": "number",
      "default": 0,
      "title": "Quantity Received",
      "description": "ServiceTitan-owned. Updated by receipt sync. Overwritten by inbound sync."
    },
    "quantity_outstanding": {
      "type": "number",
      "default": 0,
      "title": "Quantity Outstanding",
      "description": "ServiceTitan-owned. quantity_ordered - quantity_received. Overwritten by inbound sync."
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "title": "Unit Cost",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "line_total": {
      "type": "number",
      "default": 0,
      "title": "Line Total",
      "description": "ServiceTitan-owned. quantity_ordered \u00d7 unit_cost. Overwritten by inbound sync."
    },
    "line_status": {
      "type": "string",
      "enum": [
        "open",
        "partially_received",
        "received",
        "cancelled"
      ],
      "default": "open",
      "title": "Line Status",
      "description": "ServiceTitan-owned. Overwritten by inbound sync."
    },
    "replenishment_id": {
      "type": "string",
      "title": "Replenishment ID",
      "description": "LVC-owned. Links to the replenishment request that generated this line. Never overwritten by ServiceTitan."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order",
      "description": "LVC-owned. Never overwritten by ServiceTitan."
    },
    "servicetitan_po_line_id": {
      "type": "string",
      "title": "ServiceTitan PO Line ID",
      "description": "Permanent external identity. Stored as string for int64 safety. The canonical sync key \u2014 matched ONLY by this field."
    },
    "servicetitan_active": {
      "type": "boolean",
      "default": true,
      "title": "ServiceTitan Active Status"
    },
    "servicetitan_sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "conflict",
        "deferred",
        "failed",
        "deleted"
      ],
      "default": "synced",
      "title": "ServiceTitan Sync Status"
    },
    "servicetitan_last_sync": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Last Sync"
    },
    "servicetitan_last_event_at": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Last Event At"
    },
    "servicetitan_modified_on": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Modified On"
    },
    "servicetitan_created_on": {
      "type": "string",
      "format": "date-time",
      "title": "ServiceTitan Created On"
    },
    "servicetitan_sync_version": {
      "type": "number",
      "default": 0,
      "title": "ServiceTitan Sync Version"
    },
    "servicetitan_source": {
      "type": "string",
      "enum": [
        "webhook",
        "manual",
        "api"
      ],
      "title": "ServiceTitan Source"
    },
    "servicetitan_raw_data": {
      "type": "string",
      "title": "ServiceTitan Raw Data (JSON)"
    },
    "import_source": {
      "type": "string",
      "enum": [
        "webhook",
        "api_recovery",
        "on_demand_hydration",
        "manual",
        "api_export"
      ],
      "title": "Import Source"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "title": "Imported At"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "LVC-owned internal notes. Never overwritten by ServiceTitan."
    }
  },
  "required": [
    "purchase_order_id",
    "servicetitan_po_line_id",
    "quantity_ordered"
  ]
}