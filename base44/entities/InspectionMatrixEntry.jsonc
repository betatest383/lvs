    },
    "repair_system": {
      "type": "string",
      "title": "Repair System"
    },
    "finding_type": {
      "type": "string",
      "title": "Finding Type"
    },
    "severity": {
      "type": "string",
      "title": "Severity"
    },
    "recommendation_trigger": {
      "type": "boolean",
      "default": false,
      "title": "Recommendation Trigger"
    },
