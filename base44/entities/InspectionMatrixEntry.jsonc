{
  "name": "InspectionMatrixEntry",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "title": "Question ID",
      "description": "Links to InspectionQuestion record"
    },
    "section": {
      "type": "string",
      "title": "Section"
    },
    "subsection": {
      "type": "string",
      "title": "Subsection"
    },
    "category": {
      "type": "string",
      "title": "Category (Raw)"
    },
    "question_text": {
      "type": "string",
      "title": "Question Text"
    },
    "question_type": {
      "type": "string",
      "title": "Question Type"
    },
    "question_role": {
      "type": "string",
      "enum": [
        "observation",
        "measurement",
        "photo",
        "calculation_input",
        "derived_result",
        "customer_information",
        "administrative",
        "verification"
      ],
      "default": "observation",
      "title": "Question Role",
      "description": "Classifies the question's purpose \u2014 determines which gap validations apply"
    },
    "role_inferred": {
      "type": "boolean",
      "default": false,
      "title": "Role Inferred",
      "description": "True when the role was auto-inferred from question text/type, false when explicitly set on the InspectionQuestion"
    },
    "question_purpose": {
      "type": "string",
      "title": "Question Purpose (JSON)",
      "description": "JSON array of purposes. Auto-inferred from question text, role, mappings, and downstream connections."
    },
    "question_category": {
      "type": "string",
      "title": "Question Category",
      "description": "Groups related questions together regardless of form placement. Auto-inferred from question text and existing category."
    },
    "purpose_inferred": {
      "type": "boolean",
      "default": false,
      "title": "Purpose Inferred"
    },
    "category_inferred": {
      "type": "boolean",
      "default": false,
      "title": "Category Inferred"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "title": "Needs Review"
    },
    "logic_source": {
      "type": "string",
      "enum": [
        "rule",
        "manual",
        "none"
      ],
      "default": "none",
      "title": "Logic Source"
    },
    "consumes_measurements": {
      "type": "boolean",
      "default": false,
      "title": "Consumes Measurements?"
    },
    "produces_findings": {
      "type": "boolean",
      "default": false,
      "title": "Produces Findings?"
    },
    "produces_repair": {
      "type": "boolean",
      "default": false,
      "title": "Produces Repair?"
    },
    "produces_estimate": {
      "type": "boolean",
      "default": false,
      "title": "Produces Estimate?"
    },
    "produces_material_calculation": {
      "type": "boolean",
      "default": false,
      "title": "Produces Material Calculation?"
    },
    "produces_pdf": {
      "type": "boolean",
      "default": false,
      "title": "Produces PDF?"
    },
    "produces_gallery": {
      "type": "boolean",
      "default": false,
      "title": "Produces Gallery?"
    },
    "produces_timeline": {
      "type": "boolean",
      "default": true,
      "title": "Produces Timeline?"
    },
    "inspection_type": {
      "type": "string",
      "title": "Inspection Type"
    },
    "inspection_module": {
      "type": "string",
      "enum": [
        "inspection_setup",
        "interior",
        "exterior",
        "attic",
        "roof",
        "crawl_space",
        "appliance",
        "masonry",
        "commercial",
        "other"
      ],
      "default": "interior",
      "title": "Inspection Module",
      "description": "Which inspection module this question belongs to."
    },
    "display_order": {
      "type": "number",
      "title": "Display Order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    },
    "conditional_logic": {
      "type": "boolean",
      "default": false,
      "title": "Has Conditional Logic"
    },
    "shows_when": {
      "type": "string",
      "title": "Shows When (JSON)"
    },
    "hidden_when": {
      "type": "string",
      "title": "Hidden When"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "title": "Required"
    },
    "required_conditionally": {
      "type": "boolean",
      "default": false,
      "title": "Required Conditionally"
    },
    "answer_options": {
      "type": "string",
      "title": "Answer Options"
    },
    "help_text": {
      "type": "string",
      "title": "Help Text"
    },
    "photo_required": {
      "type": "boolean",
      "default": false,
      "title": "Photo Required"
    },
    "photo_optional": {
      "type": "boolean",
      "default": false,
      "title": "Photo Optional"
    },
    "photo_category": {
      "type": "string",
      "title": "Photo Category"
    },
    "photo_labels": {
      "type": "string",
      "title": "Photo Labels"
    },
    "photo_customer_pdf": {
      "type": "boolean",
      "default": false,
      "title": "Photo Customer PDF"
    },
    "photo_internal_report": {
      "type": "boolean",
      "default": true,
      "title": "Photo Internal Report"
    },
    "photo_estimate": {
      "type": "boolean",
      "default": false,
      "title": "Photo Estimate"
    },
    "photo_repair_system": {
      "type": "boolean",
      "default": false,
      "title": "Photo Repair System"
    },
    "photo_timeline": {
      "type": "boolean",
      "default": true,
      "title": "Photo Timeline"
    },
    "photo_internal_only": {
      "type": "boolean",
      "default": false,
      "title": "Photo Internal Only"
    },
    "measurement_required": {
      "type": "boolean",
      "default": false,
      "title": "Measurement Required"
    },
    "measurement_units": {
      "type": "string",
      "title": "Measurement Units"
    },
    "measurement_material_calc": {
      "type": "boolean",
      "default": false,
      "title": "Measurement Material Calc"
    },
    "measurement_estimate_qty": {
      "type": "boolean",
      "default": false,
      "title": "Measurement Estimate Qty"
    },
    "measurement_pdf_report": {
      "type": "boolean",
      "default": false,
      "title": "Measurement PDF Report"
    },
    "measurement_repair_system": {
      "type": "boolean",
      "default": false,
      "title": "Measurement Repair System"
    },
    "customer_pdf": {
      "type": "string",
      "enum": [
        "show",
        "hide",
        "conditional"
      ],
      "title": "Customer PDF"
    },
    "customer_summary": {
      "type": "boolean",
      "default": false,
      "title": "Customer Summary"
    },
    "internal_notes": {
      "type": "boolean",
      "default": false,
      "title": "Internal Notes"
    },
    "inspection_summary": {
      "type": "boolean",
      "default": true,
      "title": "Inspection Summary"
    },
    "timeline": {
      "type": "boolean",
      "default": true,
      "title": "Timeline"
    },
    "job_hub": {
      "type": "boolean",
      "default": false,
      "title": "Job Hub"
    },
    "dashboard": {
      "type": "boolean",
      "default": false,
      "title": "Dashboard"
    },
    "nfpa_211_question": {
      "type": "boolean",
      "default": false,
      "title": "NFPA 211 Question"
    },
    "code_reference": {
      "type": "string",
      "title": "Code Reference"
    },
    "pass_fail": {
      "type": "string",
      "enum": [
        "pass_fail",
        "warning",
        "na",
        "none"
      ],
      "title": "Pass / Fail / Warning / N/A"
    },
    "safety_concern": {
      "type": "boolean",
      "default": false,
      "title": "Safety Concern"
    },
    "critical_failure": {
      "type": "boolean",
      "default": false,
      "title": "Critical Failure"
    },
    "inspection_level": {
      "type": "string",
