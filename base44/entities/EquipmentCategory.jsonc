{
  "name": "EquipmentCategory",
  "type": "object",
  "properties": {
    "category_name": {
      "type": "string",
      "title": "Category Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "category_name"
  ]
}