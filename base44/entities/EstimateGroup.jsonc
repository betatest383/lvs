{
  "name": "EstimateGroup",
  "type": "object",
  "properties": {
    "group_number": {
      "type": "string",
      "title": "Group Number",
      "description": "e.g. EG-000001"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "appointment_id": {
      "type": "string",
      "title": "Appointment ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "property_id": {
      "type": "string",
      "title": "Property ID"
    },
    "group_name": {
      "type": "string",
      "title": "Group Name",
      "description": "e.g. Chimney 1 \u2014 Exterior Repairs, Chimney 1 \u2014 Complete Interior + Exterior, Immediate Safety Repairs"
    },
    "group_code": {
      "type": "string",
      "title": "Group Code",
      "description": "Short identifier e.g. CHIM1-EXT, CHIM1-COMP, SAFETY"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "interior",
        "exterior",
        "combined",
        "appliance",
        "venting",
        "safety",
        "maintenance",
        "upgrade",
        "value_package",
        "whole_property",
        "custom"
      ],
      "default": "custom",
      "title": "Group Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Property Asset IDs",
      "description": "PropertyAsset records this group references"
    },
    "primary_asset_id": {
      "type": "string",
      "title": "Primary Asset ID",
      "description": "The primary PropertyAsset for this group (for single-asset groups)"
    },
    "repair_recommendation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Repair Recommendation IDs",
      "description": "RepairSystemRecommendation IDs referenced by this group"
    },
    "inspection_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Inspection Finding IDs",
      "description": "InspectionFinding IDs referenced by this group"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "grouped",
        "options_ready",
        "scope_ready",
        "pricing_ready",
        "estimate_ready",
        "presented",
        "accepted",
        "deferred",
        "declined",
        "archived"
      ],
      "default": "draft",
      "title": "Status",
      "description": "A group is accepted or declined as a complete document. No partial-acceptance status exists; a scope change requires a revised or replacement group."
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "Display Order"
    },
    "grouping_source": {
      "type": "string",
      "enum": [
        "auto",
        "technician",
        "migration",
        "imported"
      ],
      "default": "auto",
      "title": "Grouping Source",
      "description": "How this group was created \u2014 auto = generated by the grouping engine, technician = manually created"
    },
    "customer_visible": {
      "type": "boolean",
      "default": true,
      "title": "Customer Visible"
    },
    "allow_independent_decision": {
      "type": "boolean",
      "default": true,
      "title": "Allow Independent Decision",
      "description": "When true, the customer can accept/decline this group independently"
    },
    "allow_combined_selection": {
      "type": "boolean",
      "default": false,
      "title": "Allow Combined Selection",
      "description": "When true, this group can be selected as part of a combined package"
    },
    "overlap_group_id": {
      "type": "string",
      "title": "Overlap Group ID",
      "description": "For combined groups \u2014 links to a parent group that manages overlap resolution"
    },
    "is_combined_group": {
      "type": "boolean",
      "default": false,
      "title": "Is Combined Group",
      "description": "True when this group references items from other groups (e.g. Complete Interior + Exterior)"
    },
    "source_group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Source Group IDs",
      "description": "For combined groups \u2014 the EstimateGroup IDs whose items are referenced"
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "title": "Confirmed",
      "description": "True when the technician has confirmed this grouping"
    },
    "confirmed_by": {
      "type": "string",
      "title": "Confirmed By"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Confirmed At"
    },
    "customer_decision": {
      "type": "string",
      "enum": [
        "",
        "accepted",
        "schedule_for_later",
        "think_about_it",
        "declined",
        "replaced_by_combined_package"
      ],
      "default": "",
      "title": "Customer Decision",
      "description": "A group is accepted or declined as a complete document. No partial acceptance is permitted; a scope change requires a revised or replacement group."
    },
    "decision_notes": {
      "type": "string",
      "title": "Decision Notes"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "title": "Decided At"
    },
    "customer_signature_id": {
      "type": "string",
      "title": "Customer Signature ID"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "updated_by": {
      "type": "string",
      "title": "Updated By"
    }
  },
  "required": [
    "job_id",
    "group_name",
    "group_type"
  ]
}