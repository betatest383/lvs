{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "estimate_id": {
      "type": "string",
      "title": "Estimate ID"
    },
    "inspection_id": {
      "type": "string",
      "title": "Inspection ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "line_items": {
      "type": "string",
      "title": "Line Items JSON"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate (%)",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "title": "Tax Amount"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "title": "Status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "title": "Payment Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "job_id",
    "customer_id",
    "customer_name"
  ]
}