{
  "name": "EstimateRecommendation",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string",
      "title": "Recommendation ID",
      "description": "e.g. REC-000001"
    },
    "inspection_id": {
      "type": "string",
      "title": "Inspection ID"
    },
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "finding_ids": {
      "type": "string",
      "title": "Finding IDs (JSON)",
      "description": "JSON array of InspectionFinding IDs that contributed to this recommendation"
    },
    "deficiency_type": {
      "type": "string",
      "title": "Deficiency Type"
    },
    "option_group": {
      "type": "string",
      "title": "Option Group",
      "description": "Groups competing recommendations into a customer choice (Good/Better/Best)"
    },
    "option_tier": {
      "type": "string",
      "enum": [
        "good",
        "better",
        "best",
        "standalone"
      ],
      "default": "standalone",
      "title": "Option Tier"
    },
    "option_label": {
      "type": "string",
      "title": "Option Label"
    },
    "pricebook_item_name": {
      "type": "string",
      "title": "Pricebook Item Name"
    },
    "pricebook_item_id": {
      "type": "string",
      "title": "Pricebook Item ID"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "Quantity"
    },
    "unit": {
      "type": "string",
      "default": "ea",
      "title": "Unit"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "title": "Unit Price ($)"
    },
    "line_total": {
      "type": "number",
      "default": 0,
      "title": "Line Total ($)"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Attached Photos"
    },
    "customer_description": {
      "type": "string",
      "title": "Customer-Facing Description"
    },
    "material_calculation": {
      "type": "string",
      "title": "Material Calculation (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "Technician Notes"
    },
    "is_upgrade": {
      "type": "boolean",
      "default": false,
      "title": "Optional Upgrade"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "removed",
        "customer_declined"
      ],
      "default": "pending",
      "title": "Review Status"
    },
    "estimate_id": {
      "type": "string",
      "title": "Estimate ID",
      "description": "Linked Estimate record once estimate is created from accepted recommendations"
    },
    "source": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto",
      "title": "Source",
      "description": "auto = generated by engine, manual = added by technician"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    }
  },
  "required": [
    "job_id",
    "pricebook_item_name",
    "status"
  ]
}