{
  "name": "TransferSyncWatermark",
  "type": "object",
  "properties": {
    "watermark_key": {
      "type": "string",
      "title": "Watermark Key",
      "description": "Unique key (e.g. 'transfer_go_live'). One per (tenant, environment) pair."
    },
    "sync_strategy": {
      "type": "string",
      "enum": [
        "new_transfers_only",
        "full_historical_backfill"
      ],
      "default": "new_transfers_only",
      "title": "Synchronization Strategy"
    },
    "activation_timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Activation Timestamp"
    },
    "environment": {
      "type": "string",
      "title": "Environment"
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "title": "Status"
    },
    "last_modified_scan_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Modified Scan At"
    },
    "last_created_scan_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Created Scan At"
    },
    "recovery_window_start": {
      "type": "string",
      "format": "date-time",
      "title": "Recovery Window Start"
    },
    "recovery_window_end": {
      "type": "string",
      "format": "date-time",
      "title": "Recovery Window End"
    },
    "recovery_window_status": {
      "type": "string",
      "enum": [
        "idle",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "idle",
      "title": "Recovery Window Status"
    },
    "recovery_window_errors": {
      "type": "number",
      "default": 0,
      "title": "Recovery Window Errors"
    },
    "recovery_overlap_minutes": {
      "type": "number",
      "default": 5,
      "title": "Recovery Overlap Minutes"
    },
    "transfers_imported_since_activation": {
      "type": "number",
      "default": 0,
      "title": "Transfers Imported Since Activation"
    },
    "transfers_imported_on_demand": {
      "type": "number",
      "default": 0,
      "title": "Transfers Imported On Demand"
    },
    "transfers_updated": {
      "type": "number",
      "default": 0,
      "title": "Transfers Updated"
    },
    "transfer_lines_created": {
      "type": "number",
      "default": 0,
      "title": "Transfer Lines Created"
    },
    "transfer_lines_updated": {
      "type": "number",
      "default": 0,
      "title": "Transfer Lines Updated"
    },
    "transfers_cancelled": {
      "type": "number",
      "default": 0,
      "title": "Transfers Cancelled"
    },
    "transfers_deferred_missing_warehouse": {
      "type": "number",
      "default": 0,
      "title": "Transfers Deferred (Missing Warehouse)",
      "description": "Transfers deferred because source or destination ServiceTitan warehouse ID has no local WarehouseLocation record."
    },
    "transfers_deferred_missing_material": {
      "type": "number",
      "default": 0,
      "title": "Transfer Lines Deferred (Missing Material)"
    },
    "transfer_headers_lines_pending": {
      "type": "number",
      "default": 0,
      "title": "Transfer Headers with Lines Pending",
      "description": "Transfer headers created or updated while line-level synchronization is incomplete (lines_sync_status != complete). Headers remain eligible for line retry."
    },
    "transfer_line_sync_failures": {
      "type": "number",
      "default": 0,
      "title": "Transfer Line Sync Failures",
      "description": "Total non-retriable transfer line sync failures (servicetitan_sync_status = failed)."
    },
    "webhook_events_processed": {
      "type": "number",
      "default": 0,
      "title": "Webhook Events Processed (Total)"
    },
    "webhook_events_failed": {
      "type": "number",
      "default": 0,
      "title": "Webhook Events Failed"
    },
    "recovery_events_processed": {
      "type": "number",
      "default": 0,
      "title": "Recovery Events Processed"
    },
    "last_successful_sync_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Successful Sync At"
    },
    "last_error": {
      "type": "string",
      "title": "Last Error"
    },
    "backfill_status": {
      "type": "string",
      "enum": [
        "never_started",
        "disabled",
        "confirmed",
        "in_progress",
        "completed"
      ],
      "default": "never_started",
      "title": "Backfill Status"
    },
    "backfill_started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Backfill Started At"
    },
    "backfill_confirmed_by": {
      "type": "string",
      "title": "Backfill Confirmed By"
    },
    "backfill_scope_estimate": {
      "type": "number",
      "title": "Backfill Scope Estimate"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "watermark_key",
    "sync_strategy",
    "environment",
    "tenant_id"
  ]
}