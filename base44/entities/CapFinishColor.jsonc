{
  "name": "CapFinishColor",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display Name",
      "description": "e.g. Textured Black, Bronze, Clay"
    },
    "manufacturer_color_code": {
      "type": "string",
      "title": "Manufacturer Color Code",
      "description": "The manufacturer's official color code (e.g. RAL 9005, HY-C TBK)"
    },
    "color_family": {
      "type": "string",
      "enum": [
        "black",
        "bronze",
        "brown",
        "clay",
        "gray",
        "green",
        "red",
        "white",
        "blue",
        "custom"
      ],
      "title": "Color Family"
    },
    "hex_value": {
      "type": "string",
      "title": "Hex Color Value",
      "description": "Visual swatch color, e.g. #1A1A1A"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    },
    "additional_cost": {
      "type": "number",
      "default": 0,
      "title": "Additional Cost ($)",
      "description": "Upcharge applied when this color is selected for a powder-coated cap"
    },
    "lead_time_adjustment_days": {
      "type": "number",
      "default": 0,
      "title": "Lead-Time Adjustment (Days)",
      "description": "Additional days added to the standard lead time when this color is selected"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "display_name",
    "color_family"
  ]
}