{
  "name": "FindingPricebookMapping",
  "type": "object",
  "properties": {
    "mapping_name": {
      "type": "string",
      "title": "Mapping Name",
      "description": "e.g. Cracked Crown \u2192 Crown Seal / Replace"
    },
    "deficiency_type": {
      "type": "string",
      "title": "Deficiency Type",
      "description": "Must match InspectionFinding.deficiency_type"
    },
    "severity_filter": {
      "type": "string",
      "title": "Severity Filter (JSON)",
      "description": "JSON array of severities this mapping applies to. Empty = all severities."
    },
    "appliance_system_type": {
      "type": "string",
      "title": "Appliance / System Type",
      "description": "Optional filter \u2014 must match InspectionFinding.appliance_system_type"
    },
    "pricebook_item_name": {
      "type": "string",
      "title": "Pricebook Item Name"
    },
    "pricebook_item_id": {
      "type": "string",
      "title": "Pricebook Item ID"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "title": "Unit Price ($)"
    },
    "unit": {
      "type": "string",
      "default": "ea",
      "title": "Unit of Measure"
    },
    "option_group": {
      "type": "string",
      "title": "Option Group",
      "description": "Groups related recommendations into a single choice (e.g. 'Cracked Crown Repair')"
    },
    "option_tier": {
      "type": "string",
      "enum": [
        "good",
        "better",
        "best",
        "standalone"
      ],
      "default": "standalone",
      "title": "Option Tier"
    },
    "option_label": {
      "type": "string",
      "title": "Option Label",
      "description": "e.g. 'Crown Seal (Good)', 'Remove & Replace Crown (Best)'"
    },
    "default_quantity": {
      "type": "number",
      "default": 1,
      "title": "Default Quantity"
    },
    "quantity_from_measurement": {
      "type": "string",
      "title": "Quantity From Measurement Field",
      "description": "Measurement key to use for quantity calculation (e.g. 'flue_height', 'crown_area')"
    },
    "quantity_multiplier": {
      "type": "number",
      "default": 1,
      "title": "Quantity Multiplier",
      "description": "Multiply measurement value by this factor (e.g. 1.1 for 10% waste)"
    },
    "material_calculation": {
      "type": "string",
      "title": "Material Calculation (JSON)",
      "description": "JSON object of material calculation rules: { material_name, formula, unit }"
    },
    "report_language": {
      "type": "string",
      "title": "Report Language",
      "description": "Pre-written customer-facing description for the report/estimate"
    },
    "customer_description_template": {
      "type": "string",
      "title": "Customer Description Template",
      "description": "Template for customer-facing estimate line item description"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    }
  },
  "required": [
    "deficiency_type",
    "pricebook_item_name"
  ]
}