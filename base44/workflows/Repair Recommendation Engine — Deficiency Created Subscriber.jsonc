{
  "name": "Repair Recommendation Engine \u2014 Deficiency Created Subscriber",
  "description": "Automatically triggers the Repair Recommendation Engine pipeline when a new deficiency finding is created. Runs template matching, repair system recommendations, estimate recommendations, timeline logging, and AI Sales Coach notification \u2014 no inspection rule needs to call these manually.",
  "trigger": {
    "condition": "${ ((.trigger.data.is_deficiency != false) and (.trigger.data.include_in_estimate != false) and (.trigger.data.internal_only != true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "InspectionFinding"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "repair_recommendation_engine_deficiency_created_subscriber",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDeficiencyCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDeficiencyCreated"
  }
}