{
  "name": "Post-Import Appointment Reconciliation",
  "description": "Scans for unreconciled ServiceTitan/Zapier-imported Jobs (direct Zapier creates that bypassed backend ingestion) every 5 minutes and idempotently fills blank technician, location, job-type, dispatch, and mapping fields.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-15T00:16:52.188000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_import_appointment_reconciliation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileAppointmentImport",
            "args": {
              "scan": true,
              "scan_limit": 50
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "reconcileAppointmentImport"
  }
}