{
  "name": "WH-105 Blocked \u2192 Rules Engine Evaluation",
  "description": "Triggers the Rules Engine event evaluation pipeline when a WH-105 departure check transitions to blocked status.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"overall_status\") != null) and (.trigger.data.overall_status == \"blocked\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Wh105DepartureCheck"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wh_105_blocked_rules_engine_evaluation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "evaluateRuleEvent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "evaluateRuleEvent"
  }
}